# OpenAI API Key - required for story and image generation
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# FAL AI API Key - required for alternative image generation  
# Get your API key from: https://fal.ai/dashboard
FAL_KEY=your_fal_api_key_here

# Note: Replace the placeholder values above with your actual API keys
# The web interface will not generate stories without valid API keys
